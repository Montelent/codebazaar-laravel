APP_NAME=CodeBazaar
APP_ENV=local
# Temporary key so the installer can boot. The web installer replaces this with a unique key.
APP_KEY=base64:2fl+KtvkdphvQyEfm7K5y8vPqJnR3sXtUwYzAbCdEfG=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ---------------------------------------------------------------------------
# License verification (author / sales builds)
# ---------------------------------------------------------------------------
# Envato / CodeCanyon — create token at https://build.envato.com/create-token/
# Required scopes: "View and search Envato sites", "View your sales"
ENVATO_PERSONAL_TOKEN=
ENVATO_ITEM_ID=
# true = only real Envato API sales unlock (recommended for selling)
ENVATO_REQUIRE_LIVE=true

# JigSource.store live validation
JIGSOURCE_VERIFY_URL=https://jigsource.store/api/purchases/validation
JIGSOURCE_API_KEY=
JIGSOURCE_ITEM_ID=
JIGSOURCE_PRODUCT=codebazaar
# Optional: offline signed JS1.*.* keys
JIGSOURCE_LICENSE_SECRET=

# Author-only: unlock everything without a purchase code
# DISABLE_PRODUCT_LICENSE=true
